 10  dir /bogus
 11  dir new /b
 12  echo kept > out.txt
 13  echo more >> out.txt
 14  type out.txt
 15  type nosuch.txt
 16  ren out.txt done.txt && del new\*.* && rd new
 17  ren done.txt notes.txt
 18  move done.txt c:\tools
 19  dir c:\tools /b
 20  nosuch
 21  echo %ERRORLEVEL%
 22  a one two
 23  echo %ERRORLEVEL%
 24  b && echo after b
 25  b || echo not after a success
 26  tool /x
 27  run
 28  where b
 29  where tool.exe
 30  where nosuch
 31  c:\bin\a.com direct
 32  start tool
 33  dir | sort
 34  dir /b *.txt > list.txt
 35  del list.txt
 36  path
 37  path c:\bin
 38  where b
