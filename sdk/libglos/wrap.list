# The C library's functions libglos puts its lock round (gloswrap.c), one a line: the linker's
# --wrap options are made from this (build/sdk/gloswrap.opt), and tools/wrapcheck.py checks a linked
# program's map against it.
malloc
free
calloc
realloc
fopen
freopen
fdopen
fclose
fflush
fread
fwrite
fgets
fputs
fgetc
fputc
ungetc
puts
fseek
ftell
rewind
fgetpos
fsetpos
setvbuf
setbuf
perror
remove
rename
tmpfile
printf
fprintf
vprintf
vfprintf
sprintf
vsprintf
snprintf
vsnprintf
scanf
fscanf
sscanf
vfscanf
vsscanf
open
creat
close
read
write
lseek
dup
dup2
unlink
stat
fstat
access
mkdir
rmdir
chdir
getcwd
chmod
ftruncate
fsync
opendir
readdir
closedir
rewinddir
findfirst
findnext
rand
srand
# Not locked, but taken over (gloswrap.c): DJGPP's last step of exit, in a program that has made threads.
__exit
